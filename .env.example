# Copy to .env.local and fill in. Both are required — src/lib/supabase.ts throws
# without them rather than failing later with an opaque network error.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional. When set, the sign-in form requires a captcha (and Supabase Auth must
# have hCaptcha enabled with the matching SECRET under Auth > Attack Protection —
# a site key here with no secret there makes sign-in fail, not just be unguarded).
# The same site key is reused by the public feedback/comment forms in Phase 4.
VITE_HCAPTCHA_SITE_KEY=
